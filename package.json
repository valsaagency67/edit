{
  "name": "my-video",
  "version": "1.0.0",
  "description": "A Remotion template for TikTok-style captions",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/zod-types": "4.0.535",
    "@remotion/animation-utils": "4.0.535",
    "@remotion/layout-utils": "4.0.535",
    "@remotion/media-utils": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@remotion/install-whisper-cpp": "4.0.535",
    "@remotion/captions": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "create-subtitles": "node sub.mjs",
    "proxies": "scripts/proxies.sh",
    "master": "scripts/master.sh",
    "audio": "scripts/extract-audio.sh",
    "transcribe": "node scripts/transcribe.mjs",
    "render:vigilante": "remotion render src/index.ts JFC-Vigilante out/JFC-Vigilante.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k --jpeg-quality=95 --concurrency=4 --timeout=120000",
    "render:destacadas": "for h in INFO JUVENTUD TERRITORIO; do remotion still src/index.ts Destacada-$h out/destacada-$h.png; done",
    "render:portada": "remotion still src/index.ts JFC-Portada out/portada.png",
    "render:borrador": "remotion render src/index.ts JFC-Vigilante-Borrador out/borrador.mp4 --scale=0.5 --codec=h264 --crf=23 --audio-codec=aac --audio-bitrate=128k --concurrency=4 --timeout=120000"
  }
}
